# Root-level ignore file: defense-in-depth for any build invoked with the
# repo root as context (e.g. `docker build -f backend/Dockerfile .`). The
# per-service .dockerignore files (backend/.dockerignore, frontend/.dockerignore)
# are authoritative for the default docker-compose.yml contexts (./backend,
# ./frontend); this file exists so a root-context build can't accidentally
# pick up the same local/dev/test artifacts.
.git/
.gitignore
.pnpm-store/
**/.pnpm-store/
node_modules/
**/node_modules/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
.pytest_cache/
.ruff_cache/
tests/
docs/
.superpowers/
.claude/
scripts/dev/
logs/
**/logs/
*.log
**/*.log
.env
.env.*
**/.env
**/.env.*
